pipeline {
    agent any
    stages {

        stage('Build with Maven') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t swaraliapp .'
            }
        }

        stage('Run Container') {
            steps {
                bat 'docker rm -f swarali_container || exit 0'
                bat 'docker run --name swarali_container swaraliapp'
            }
        }

    }
}
